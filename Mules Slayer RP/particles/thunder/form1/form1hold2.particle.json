{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "thunder:hold2",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/thunder/aura"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 3
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_disc": {
				"radius": 0.9,
				"direction": "outwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(1.2)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-180, 180)"
			},
			"minecraft:particle_initial_speed": "math.random(7,10)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, "math.random(1,2)", 0],
				"linear_drag_coefficient": "math.random(1,2)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.5, 0.5],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 1200,
					"texture_height": 6000,
					"flipbook": {
						"base_UV": ["math.floor(v.particle_random_2*3) * 400", "math.floor(v.particle_random_1*20) * 300"],
						"size_UV": [400, 300],
						"step_UV": [0, 300],
						"frames_per_second": 24,
						"max_frame": 21,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#8CFFFFFF",
						"0.15": "#FFFFFFFF",
						"0.62": "#8CFFFFFF",
						"1.0": "#54000000"
					}
				}
			}
		}
	}
