				"linear_drag_coefficient": 1.4
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_2*7", "v.particle_random_2*7"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 336,
					"texture_height": 336,
					"uv": [0, 0],
					"uv_size": [336, 336]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00001EFF",
						"0.19": "#12FFFFFF",
						"0.49": "#243E4171",
						"0.73": "#14DEDEFF",
						"1.0": "#000200FF"
