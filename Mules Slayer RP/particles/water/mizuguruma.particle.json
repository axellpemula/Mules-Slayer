{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "water:wheel",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/water/formb"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 13
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.5,1)", 1, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.3,0.75)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-360,360)",
				"rotation_rate": "v.particle_random_2*450"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["3.5+v.particle_random_2*2", "3.75+v.particle_random_2*1"],
				"facing_camera_mode": "emitter_transform_yz",
				"uv": {
					"texture_width": 8000,
					"texture_height": 450,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [500, 450],
						"step_UV": [500, 0],
						"frames_per_second": 12,
						"max_frame": 17,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#00FFFFFF",
						"0.17": "#ffffffff",
						"0.79": "#FFFFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}