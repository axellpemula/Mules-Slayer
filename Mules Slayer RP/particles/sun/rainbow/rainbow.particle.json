{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sun:rainbow",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/flame/menyala"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 80
			},
			"minecraft:emitter_lifetime_expression": {},
			"minecraft:emitter_shape_sphere": {
				"radius": 3,
				"direction": "inwards"
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.8,2.5)"
			},
			"minecraft:particle_initial_speed": "math.random_integer(30,5)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": ["math.random(-25,25)", "math.random(-25,25)", "math.random(-25,25)"],
				"linear_drag_coefficient": "math.random_integer(5,15)"
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_2*0.4/variable.particle_age", "v.particle_random_2*0.4"],
				"facing_camera_mode": "lookat_direction",
				"uv": {
					"texture_width": 16,
					"texture_height": 16,
					"uv": [0, 0],
					"uv_size": [16, 16]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FFDBFBFF",
						"0.26": "#FFFF263C",
						"0.39": "#FF1540FF",
						"0.51": "#D6FF82E1",
						"0.62": "#FF1DFF1F",
						"0.75": "#FFFFE599",
						"1.0": "#00FFA6A6"
					}
				}
			}
		}
