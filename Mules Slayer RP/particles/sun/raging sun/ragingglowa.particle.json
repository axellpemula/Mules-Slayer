{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "sun:ragingglowa",
			"basic_render_parameters": {
				"material": "particles_add",
				"texture": "textures/particle/sun/raging"
			}
		},
		"components": {
			"minecraft:emitter_local_space": {
				"position": true,
				"rotation": true,
				"velocity": true
			},
			"minecraft:emitter_rate_instant": {
				"num_particles": 3
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": ["math.random(-0.5,0.5)", 0, 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.5,0.7)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(0,15)"
			},
			"minecraft:particle_initial_speed": 0,
			"minecraft:particle_motion_dynamic": {},
			"minecraft:particle_appearance_billboard": {
				"size": ["4 + v.particle_age*2", "5 + v.particle_age*2"],
				"facing_camera_mode": "emitter_transform_yz",
				"uv": {
					"texture_width": 7000,
					"texture_height": 450,
					"flipbook": {
						"base_UV": [0, 0],
						"size_UV": [500, 450],
						"step_UV": [500, 0],
						"frames_per_second": 20,
						"max_frame": 14,
						"stretch_to_lifetime": true
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#94FFFFFF",
						"0.57": "#94FFFFFF",
						"1.0": "#00FFFFFF"
					}
				}
			}
		}
	}
}