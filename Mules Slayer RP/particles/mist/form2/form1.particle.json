{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "mist:form1",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/asap"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": 130
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"offset": [0, "math.random(0,3)", 0]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": "math.random(0.4,1)"
			},
			"minecraft:particle_initial_spin": {
				"rotation": "math.random(-360,360)"
			},
			"minecraft:particle_initial_speed": "v.particle_random_2*5",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, 5, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": ["v.particle_random_2*1+v.particle_age", "v.particle_random_2*1+v.particle_age"],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 336,
					"texture_height": 336,
					"uv": [0, 0],
					"uv_size": [336, 336]
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF185F58",
						"0.12": "#66D0FDFF",
						"0.63": "#3BD8FDFF",
						"0.73": "#14FFFFFF",
						"1.0": "#00000000"
					}
				}
			}
		}
	}
}