{
    "format_version": "1.19.0",
    "animation_controllers": {
        "controller.animation.dual_chainac": {
            "initial_state": "idle",
            "states": {
                "idle": {
                    "animations": [
                        "dual_chain_idle",
                        "nichirin_hold"
                    ],
                    "transitions": [
                        {
                            "walking": "q.ground_speed > 0.5 && q.modified_move_speed && !q.is_sneaking"
                        },
                        {
                            "sneaking": "q.is_sneaking"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "walking": {
                    "animations": [
                        "dual_chain_walk",
                        "nichirin_hold"
                    ],
                    "transitions": [
                        {
                            "idle": "q.ground_speed < 0.5 && !q.is_sneaking"
                        },
                        {
                            "sneaking": "q.is_sneaking"
                        },
                        {
                            "Running": "q.modified_move_speed && q.is_sprinting"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "Running": {
                    "animations": [
                        "dual_chain_run"
                    ],
                    "transitions": [
                        {
                            "walking": "q.ground_speed < 3.9 && !q.is_sprinting"
                        },
                        {
                            "sneaking": "q.is_sneaking"
                        }
                    ],
                    "blend_transition": 0.4
                },
                "sneaking": {
                    "animations": ["dual_chain_sneak"],
                    "transitions": [
                        {
                            "idle": "q.ground_speed < 0.4 && !q.is_sneaking"
                        },
                        {
                            "jongwalking": "q.ground_speed > 0.4 && q.modified_move_speed"
                        }
                    ],
                    "blend_transition": 0.2
                },
                "jongwalking": {
                    "animations": ["dual_chain_sneak_walk"],
                    "transitions": [
                        {
                            "idle": "q.ground_speed < 0.4 && !q.is_sneaking"
                        },
                                                {
                            "Running": "q.modified_move_speed && q.is_sprinting"
                        },
                        {
                            "walking": "q.ground_speed > 0.5 && !q.is_sneaking"
                        }
                    ],
                    "blend_transition": 0.2
                }
            }
        }
    }
}
