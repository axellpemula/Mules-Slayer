    "from": 0.48,
    "to": 0.96,
    "next": "@xvoid_hud.anim_glow_pulse_down"
  },
  "anim_glow_pulse_down": {
    "anim_type": "alpha",
    "easing": "in_out_sine",
    "duration": 0.9,
    "from": 0.96,
    "to": 0.48,
    "next": "@xvoid_hud.anim_glow_pulse"
  },

