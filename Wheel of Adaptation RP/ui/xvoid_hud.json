  "emblem_glow": {
    "type": "image",
    "texture": "textures/ui/xvoid/hud_emblem_glow",
    "size": [ 42, 42 ],
    "bilinear": true,
    "alpha": "@xvoid_hud.anim_glow_pulse",
    "layer": 1,
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - '§s§h§g§r') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },

  "emblem_idle": {
    "type": "image",
    "texture": "textures/ui/xvoid/hud_emblem",
    "size": [ 32, 32 ],
    "bilinear": false,
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#hud_title_text_string - '§s§p§i§n') = #hud_title_text_string)",
        "target_property_name": "#visible"
      }
    ]
  },

  "emblem_spin": {
    "type": "image",
    "texture": "textures/ui/xvoid/hud_emblem_spin",
    "size": [ 32, 32 ],
    "uv": "@xvoid_hud.anim_spin_0",
    "uv_size": [ 64, 64 ],
    "bilinear": false,
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "((not ((#hud_title_text_string - '§s§p§i§n') = #hud_title_text_string)) and ((#hud_title_text_string - '§s§h§f§s') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },

  "emblem_spin_fast": {
    "type": "image",
    "texture": "textures/ui/xvoid/hud_emblem_spin",
    "size": [ 32, 32 ],
    "uv": "@xvoid_hud.anim_fast_0",
    "uv_size": [ 64, 64 ],
    "bilinear": false,
    "layer": 2,
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - '§s§h§f§s') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  },

  "emblem_box": {
    "type": "panel",
    "size": [ 36, 48 ],
    "controls": [
      { "glow@xvoid_hud.emblem_glow": {} },
      { "idle@xvoid_hud.emblem_idle": {} },
      { "spin@xvoid_hud.emblem_spin": {} },
      { "fast@xvoid_hud.emblem_spin_fast": {} }
    ]
  },

  "rule_box": {
    "type": "panel",
    "size": [ 1, 48 ],
    "controls": [
      {
        "rule": {
          "type": "image",
          "texture": "textures/ui/xvoid/hud_rule",
          "size": [ 1, 40 ],
          "alpha": 0.85
        }
      }
    ]
  },

  "title_label": {
    "type": "label",
    "text": "#text",
    "color": [ 1, 1, 1 ],
    "shadow": true,
    "localize": false,
    "font_scale_factor": 0.82,
    "line_padding": 1,
    "text_alignment": "left",
    "size": [ "default", "default" ],
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_name_override": "#text",
        "binding_type": "global"
      }
    ]
  },

  "subtitle_label": {
    "type": "label",
    "text": "#text",
    "color": [ 0.9, 0.9, 0.94 ],
    "shadow": true,
    "localize": false,
    "font_scale_factor": 0.78,
    "line_padding": 1,
    "text_alignment": "left",
    "size": [ "default", "default" ],
    "bindings": [
      {
        "binding_name": "#hud_subtitle_text_string",
        "binding_name_override": "#text",
        "binding_type": "global"
      }
    ]
  },

  "text_col": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "100%c", "100%c" ],
    "controls": [
      { "top_pad": { "type": "panel", "size": [ 1, 4 ] } },
      { "title@xvoid_hud.title_label": {} },
      { "mid_pad": { "type": "panel", "size": [ 1, 2 ] } },
      { "subtitle@xvoid_hud.subtitle_label": {} },
      { "bot_pad": { "type": "panel", "size": [ 1, 4 ] } }
    ]
  },

  "content": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", "100%c" ],
    "layer": 2,
    "controls": [
      { "left_pad": { "type": "panel", "size": [ 5, 1 ] } },
      { "emblem@xvoid_hud.emblem_box": {} },
      { "gap_a": { "type": "panel", "size": [ 4, 1 ] } },
      { "rule@xvoid_hud.rule_box": {} },
      { "gap_b": { "type": "panel", "size": [ 5, 1 ] } },
      { "text@xvoid_hud.text_col": {} },
      { "right_pad": { "type": "panel", "size": [ 7, 1 ] } }
    ]
  },

  "bg": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [ 0.05, 0.05, 0.08 ],
    "alpha": 0.62,
    "layer": 1,
    "size": [ "100%sm", "100%sm" ]
  },

  "card": {
    "type": "panel",
    "size": [ "100%c", "100%c" ],
    "controls": [
      { "content@xvoid_hud.content": {} },
      { "bg@xvoid_hud.bg": {} }
    ]
  },

  "root": {
    "type": "panel",
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [ 8, -8 ],
    "size": [ "100%c", "100%c" ],
    "layer": 5,
    "controls": [
      { "card@xvoid_hud.card": {} }
    ],
    "bindings": [
      {
        "binding_name": "#hud_title_text_string",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not ((#hud_title_text_string - '§s§h§s§h') = #hud_title_text_string))",
        "target_property_name": "#visible"
      }
    ]
  }
}
