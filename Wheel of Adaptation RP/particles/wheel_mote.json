{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:wheel_mote",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/soft_dot"
      }
    },
    "components": {
      "minecraft:emitter_local_space": {
        "position": true,
        "rotation": false
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": "v.emitter_age > 0.06 && v.emitter_age < 4.3 ? 34 : 0",
        "max_particles": 64
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 4.4
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.72,
        "plane_normal": "y",
        "surface_only": true,
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.65, 1.15)"
      },
      "minecraft:particle_initial_speed": "math.random(0.25, 0.65)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.45,
          0
        ],
        "linear_drag_coefficient": 0.9
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.09 * (1 - (v.particle_age / v.particle_lifetime) * 0.85)",
          "0.09 * (1 - (v.particle_age / v.particle_lifetime) * 0.85)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [
              1.0,
              0.96,
              0.72,
              1.0
            ],
            "0.50": [
              1.0,
              0.82,
              0.28,
              0.95
            ],
            "1.00": [
              1.0,
              0.58,
              0.12,
              0.0
            ]
          }
        }
      }
    }
  }
}
