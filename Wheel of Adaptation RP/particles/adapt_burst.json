{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:adapt_burst",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/spark"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 42
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.25,
        "direction": "outwards"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.45, 0.85)"
      },
      "minecraft:particle_initial_speed": "math.random(4.5, 9.2) * (v.scale ? v.scale : 1.0)",
      "minecraft:particle_initial_spin": {
        "rotation": "math.random(0, 360)",
        "rotation_rate": 240
      },
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 4.6,
        "linear_acceleration": [
          0,
          -1.2,
          0
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.24 * (v.scale ? v.scale : 1.0) * (1 - v.particle_age / v.particle_lifetime)",
          "0.24 * (v.scale ? v.scale : 1.0) * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "1.0 + ((v.tint ? v.r : 1.0) - 1.0) * math.min(1, (v.particle_age / v.particle_lifetime) * 2.4)",
          "0.96 + ((v.tint ? v.g : 0.84) - 0.96) * math.min(1, (v.particle_age / v.particle_lifetime) * 2.4)",
          "0.80 + ((v.tint ? v.b : 0.28) - 0.80) * math.min(1, (v.particle_age / v.particle_lifetime) * 2.4)",
          "1.0 - (v.particle_age / v.particle_lifetime) * (v.particle_age / v.particle_lifetime)"
        ]
      }
    }
  }
}
