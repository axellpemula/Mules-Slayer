{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:domain_pillar_core",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": ["math.random(-1.1, 1.1)", 0, "math.random(-1.1, 1.1)"],
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": 1.35
      },
      "minecraft:particle_initial_speed": "math.random(12.0, 18.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 2.5, 0],
        "linear_drag_coefficient": 1.1
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.15 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.55) * (v.scale ? v.scale : 1.0)",
          "11.5 * (0.4 + 0.85 * math.sin((v.particle_age / v.particle_lifetime) * 90)) * (v.scale ? v.scale : 1.0)"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [0, 0],
          "uv_size": [1, 1]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [1.0, 0.72, 0.72, 0.0],
            "0.16": [0.98, 0.14, 0.22, 0.85],
            "0.72": [0.58, 0.04, 0.14, 0.52],
            "1.00": [0.22, 0.02, 0.08, 0.0]
          }
        }
      }
    }
  }
}
