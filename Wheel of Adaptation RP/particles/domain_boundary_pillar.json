      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [1.0, 0.42, 0.48, 0.0],
            "0.18": [0.95, 0.10, 0.16, 0.90],
            "0.75": [0.55, 0.04, 0.12, 0.55],
            "1.00": [0.22, 0.02, 0.06, 0.0]
          }
        }
