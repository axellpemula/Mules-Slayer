{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:domain_boundary_pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 4
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_point": {
        "offset": ["math.random(-0.35, 0.35)", 0, "math.random(-0.35, 0.35)"],
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.75, 1.15)"
      },
      "minecraft:particle_initial_speed": "math.random(4.5, 8.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 1.2, 0],
        "linear_drag_coefficient": 1.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.22 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.65)",
