{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "xvoid:domain_fuga_pillar",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/xvoid/streak"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 48
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.05
      },
      "minecraft:emitter_shape_disc": {
        "radius": "3.6 * (v.scale ? v.scale : 1.0)",
        "plane_normal": "y",
        "surface_only": false,
        "direction": [0, 1, 0]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.1, 1.85)"
      },
      "minecraft:particle_initial_speed": "math.random(14.0, 26.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [0, 3.5, 0],
        "linear_drag_coefficient": 0.85
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "1.15 * (1.0 - (v.particle_age / v.particle_lifetime) * 0.45) * (v.scale ? v.scale : 1.0)",
          "9.5 * (0.45 + 0.9 * math.sin((v.particle_age / v.particle_lifetime) * 90)) * (v.scale ? v.scale : 1.0)"
        ],
        "facing_camera_mode": "rotate_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [0, 0],
          "uv_size": [1, 1]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": [1.0, 0.96, 0.72, 0.98],
            "0.28": [1.0, 0.48, 0.08, 0.96],
            "0.72": [0.95, 0.16, 0.06, 0.72],
            "1.00": [0.45, 0.04, 0.02, 0.0]
          }
