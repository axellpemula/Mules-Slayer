      "minecraft:particle_initial_speed": "4.2 * (v.scale ? v.scale : 1.0)",
      "minecraft:particle_motion_dynamic": {
        "linear_drag_coefficient": 0.9
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.07 + 0.14 * (v.particle_age / v.particle_lifetime)) * (v.scale ? v.scale : 1.0)",
          "(0.07 + 0.14 * (v.particle_age / v.particle_lifetime)) * (v.scale ? v.scale : 1.0)"
