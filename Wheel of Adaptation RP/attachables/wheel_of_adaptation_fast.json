{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "xvoid:wheel_of_adaptation_fast",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint",
        "glow": "entity_beam_additive",
        "lit": "entity_emissive"
      },
      "textures": {
        "default": "textures/entity/xvoid/wheel_of_adaptation",
        "enchanted": "textures/misc/enchanted_item_glint",
        "glow": "textures/entity/xvoid/wheel_of_adaptation_fast_glow",
        "lit_0": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_0",
        "lit_1": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_1",
        "lit_2": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_2",
        "lit_3": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_3",
        "lit_4": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_4",
        "lit_5": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_5",
        "lit_6": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_6",
        "lit_7": "textures/entity/xvoid/wheel_of_adaptation_fast_lit_7"
      },
      "geometry": {
        "default": "geometry.xvoid.wheel_of_adaptation",
        "glow": "geometry.xvoid.wheel_of_adaptation_glow"
      },
      "animations": {
        "hide_first_person": "animation.xvoid.wheel.hide_first_person",
        "idle": "animation.mahoraga_wheel.idle",
        "adapt_fast": "animation.mahoraga_wheel.adapt_fast",
        "glow_fx": "animation.xvoid.wheel.glow_fx"
      },
      "scripts": {
        "pre_animation": [
          "v.glow_time = (v.glow_time ?? 0) + q.delta_time;",
          "v.glow = v.glow_time < 0.30 ? (v.glow_time / 0.30) * 0.88 : (v.glow_time < 0.58 ? 0.98 : math.max(0, 0.98 * (1.0 - v.glow_time) / 0.42));"
        ],
        "animate": [
          "idle",
          {
            "hide_first_person": "c.is_first_person"
          },
          "adapt_fast",
          "glow_fx"
        ]
      },
      "render_controllers": [
        "controller.render.xvoid_wheel_lit",
        "controller.render.xvoid_wheel_glow"
      ],
      "particle_effects": {
        "mote": "xvoid:wheel_mote"
      }
    }
  }
}
