{
    "format_version": "1.20.60",
  "minecraft:entity": {
    "description": {
      "identifier": "sun:flower",     
      "runtime_identifier": "axell:custom",
      "is_spawnable": false,
      "is_summonable": true,
      "is_experimental": false
    },
      "component_groups": {
        "timer": {
          "minecraft:timer": {
            "time": 1,
            "looping": false,
            "time_down_event": {
              "event": "despawn_event"
            }
          }
        },
        "despawn": {
          "minecraft:instant_despawn": {}
        }
      },
      "components": {
        "minecraft:health": {
          "value": 1
        },
        "minecraft:nameable": {
          "always_show": true
        },
        "minecraft:type_family": {
          "family": [
            "inanimate",
            "real"
          ]
        },
        "minecraft:knockback_resistance": {
          "value": 1
        },
        "minecraft:damage_sensor": {
          "triggers": {
            "on_damage": {},
            "deals_damage": false
          }
        },
        "minecraft:collision_box": {
          "width": 0.01,
          "height": 0.01
        },
        "minecraft:physics": {
          "has_gravity": false
        },
        "minecraft:pushable": {
          "is_pushable": false,
          "is_pushable_by_piston": false
        }
      },
      "events": {
        "minecraft:entity_spawned": {
          "add": {
            "component_groups": [
              "timer"
            ]
          }
        },
        "despawn_event": {
          "add": {
            "component_groups": [
              "despawn"
            ]
          }
        }
      }
    }
  }
  